# ============================================================
# ATIDETO Website — Frontend environment variables
# ============================================================
# Production: absolute HTTPS URL of the deployed backend API, no trailing slash.
# Development: leave empty — Vite proxies /api to http://localhost:5000.
VITE_API_URL=

# Firebase (used by some pages for analytics / client-side services)
# These are PUBLIC client config values, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
